{
  "version": 8,
  "name": "Test Style",
  "sources": {
    "vector-tiles": {
      "type": "vector",
      "url": "https://example.com/tiles.json"
    }
  },
  "layers": [
    {
      "id": "water",
      "type": "fill",
      "source": "vector-tiles",
      "source-layer": "water",
      "minzoom": 0,
      "maxzoom": 22,
      "paint": {
        "fill-color": "#a0cfdf",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "vector-tiles",
      "source-layer": "roads",
      "minzoom": 10,
      "filter": ["==", "type", "primary"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ff6b35",
        "line-width": 3,
        "line-opacity": 0.9
      }
    },
    {
      "id": "buildings",
      "type": "fill-extrusion",
      "source": "vector-tiles",
      "source-layer": "buildings",
      "minzoom": 15,
      "paint": {
        "fill-extrusion-color": "#cccccc",
        "fill-extrusion-height": 20,
        "fill-extrusion-base": 0,
        "fill-extrusion-opacity": 0.8
      }
    },
    {
      "id": "cities",
      "type": "symbol",
      "source": "vector-tiles",
      "source-layer": "places",
      "minzoom": 5,
      "filter": [">=", "population", 100000],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Open Sans Bold", "Arial Unicode MS Bold"],
        "text-size": 14,
        "text-transform": "uppercase",
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2,
        "text-opacity": 1.0
      }
    },
    {
      "id": "poi-markers",
      "type": "circle",
      "source": "vector-tiles",
      "source-layer": "pois",
      "minzoom": 12,
      "filter": ["==", "category", "restaurant"],
      "paint": {
        "circle-radius": 6,
        "circle-color": "#ff0000",
        "circle-opacity": 0.8,
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff",
        "circle-stroke-opacity": 1.0
      }
    },
    {
      "id": "highway-markers",
      "type": "line",
      "source": "vector-tiles",
      "source-layer": "roads",
      "minzoom": 8,
      "maxzoom": 16,
      "filter": ["==", "class", "motorway"],
      "layout": {
        "line-cap": "butt"
      },
      "paint": {
        "line-color": "#e9ac77",
        "line-width": 5,
        "line-dasharray": [2, 1]
      }
    }
  ]
}
